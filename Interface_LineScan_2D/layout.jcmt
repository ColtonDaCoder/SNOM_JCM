<?
# ---------------------------------------------------------------------------
# 2D layout (Cartesian, fields invariant along z), lengths in nm.
# x: lateral, y: height.  y = 0 is the top surface of the SiN window.
#
#   air (1)              y > 0           Pt tip (3), apex at y = gap; in 2D a ridge along z
#   SiN (7)              -t_SiN < y < 0
#   water (2)            y < -t_SiN
#   oil block (9)        x_interface < x < half - patch_margin, -t_SiN - oil_depth < y < -t_SiN
#
# The oil is a finite block in bulk water, as in 3D: the exterior (PML) must see the same
# air / SiN / water stack on both sides.  Rectangles are Polygons with absolute coordinates.
# Tip: polygon with a 75 nm CornerRounding at the apex = circle tangent to both flanks.
# Mesh: one global MaximumSideLength only (no local refinement regions, which give abrupt
# element-size changes); HAdaptive refines the start mesh where the error estimate requires.
# ---------------------------------------------------------------------------
import numpy as np
half = 0.5*keys['cd_width']
t, g, R = keys['t_SiN'], keys['gap'], keys['tip_radius']
alpha = np.deg2rad(keys['tip_half_angle'])
y_bot = -t - keys['liquid_depth']
y_top = g + keys['tip_length'] + keys['air_above_tip']
def rect(x0, x1, y0, y1):
    return '%.6g %.6g, %.6g %.6g, %.6g %.6g, %.6g %.6g' % (x0, y0, x1, y0, x1, y1, x0, y1)
keys['cd_pts'] = rect(-half, half, y_bot, y_top)
keys['water_pts'] = rect(-half, half, y_bot, -t)
keys['sin_pts'] = rect(-half, half, -t, 0.0)
xp = half - keys['patch_margin']
keys['oil_pts'] = rect(keys['x_interface'], xp, -t - keys['oil_depth'], -t)
# equivalent monolayer windows: the part of the window above the oil block is its own domain (10),
# because the equivalent layer is the monolayer plus a liquid filler (oil above oil, water above water)
keys['winoil_block'] = ''
if keys.get('win_split', 0):
    keys['winoil_block'] = ('    Polygon {\n      Name = "WindowOverOil"\n      DomainId = 10\n      Priority = 2\n'
                            '      Points = [' + rect(keys['x_interface'], xp, -t, 0.0) + ']\n    }\n')
# uniform stacks (stack stages): keys['stack'] = [[DomainId, thickness], ...] from the top surface down,
# keys['stack_substrate'] = DomainId below the stack (1 = air); replaces the window / water / oil objects,
# t_SiN = total stack thickness
def poly(name, dom, pri, pts):
    return ('    Polygon {\n      Name = "%s"\n      DomainId = %d\n      Priority = %d\n      Points = [%s]\n    }\n'
            % (name, dom, pri, pts))
if keys.get('stack'):
    body = ''
    y = 0.0
    for i, (dom, th) in enumerate(keys['stack']):
        body += poly('Layer%d' % (i + 1), int(dom), 1, rect(-half, half, y - th, y))
        y -= th
    if abs(y + t) > 1e-9:
        raise ValueError('t_SiN must equal the total stack thickness')
    if int(keys['stack_substrate']) != 1:
        body += poly('Substrate', int(keys['stack_substrate']), 1, rect(-half, half, y_bot, -t))
    keys['body_block'] = body
else:
    keys['body_block'] = (poly('Water', 2, 1, keys['water_pts']) + poly('SiN', 7, 1, keys['sin_pts'])
                          + poly('OilBlock', 9, 2, keys['oil_pts']) + keys['winoil_block'])
# tip: virtual apex of the cone so that the rounded tip touches y = gap
y_v = g - R/np.sin(alpha) + R
y_tt = g + keys['tip_length']
r_tt = (y_tt - y_v)*np.tan(alpha)
keys['tip_pts'] = '%.6g %.6g, %.6g %.6g, %.6g %.6g' % (0.0, y_v, r_tt, y_tt, -r_tt, y_tt)
?>
Layout2D {
  UnitOfLength = 1e-09
  MeshOptions {
    MaximumSideLength = %(max_side)e
  }
  BoundaryConditions {
    Boundary {
      Direction = All
      Class = Transparent
    }
  }
  Objects {
    Polygon {
      Name = "CD"
      DomainId = 1
      Priority = ComputationalDomain
      Points = [%(cd_pts)s]
    }
%(body_block)s    Polygon {
      Name = "Tip"
      DomainId = 3
      Priority = 4
      Points = [%(tip_pts)s]
      CornerRounding {
        Point = 1
        Radius = %(tip_radius)e
        NPoints = 64
      }
      MeshOptions {
        CurvilinearDegree = %(tip_curv)i
      }
    }
  }
}
