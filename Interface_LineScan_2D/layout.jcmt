<?
# ---------------------------------------------------------------------------
# 2D layout (Cartesian, fields invariant along z), lengths in nm.
# x: lateral, y: height.  y = 0 is the top surface of the SiN window.
#
#   air (1)              y > 0           Pt tip (3), apex at y = gap; in 2D a ridge along z
#   SiN (7)              -t_SiN < y < 0
#   water (2)            y < -t_SiN
#   oil block (9)        x_interface < x < half - patch_margin, -t_SiN - oil_depth < y < -t_SiN
#
# The oil is a finite block in bulk water, as in 3D: the exterior (PML) must see the same
# air / SiN / water stack on both sides.  Rectangles are Polygons with absolute coordinates.
# Tip: polygon with a 75 nm CornerRounding at the apex = circle tangent to both flanks.
# Mesh: one global MaximumSideLength only (no local refinement regions, which give abrupt
# element-size changes); HAdaptive refines the start mesh where the error estimate requires.
# ---------------------------------------------------------------------------
import numpy as np
half = 0.5*keys['cd_width']
t, g, R = keys['t_SiN'], keys['gap'], keys['tip_radius']
alpha = np.deg2rad(keys['tip_half_angle'])
y_bot = -t - keys['liquid_depth']
y_top = g + keys['tip_length'] + keys['air_above_tip']
def rect(x0, x1, y0, y1):
    return '%.6g %.6g, %.6g %.6g, %.6g %.6g, %.6g %.6g' % (x0, y0, x1, y0, x1, y1, x0, y1)
keys['cd_pts'] = rect(-half, half, y_bot, y_top)
keys['water_pts'] = rect(-half, half, y_bot, -t)
keys['sin_pts'] = rect(-half, half, -t, 0.0)
xp = half - keys['patch_margin']
keys['oil_pts'] = rect(keys['x_interface'], xp, -t - keys['oil_depth'], -t)
# tip: virtual apex of the cone so that the rounded tip touches y = gap
y_v = g - R/np.sin(alpha) + R
y_tt = g + keys['tip_length']
r_tt = (y_tt - y_v)*np.tan(alpha)
keys['tip_pts'] = '%.6g %.6g, %.6g %.6g, %.6g %.6g' % (0.0, y_v, r_tt, y_tt, -r_tt, y_tt)
?>
Layout2D {
  UnitOfLength = 1e-09
  MeshOptions {
    MaximumSideLength = %(max_side)e
  }
  BoundaryConditions {
    Boundary {
      Direction = All
      Class = Transparent
    }
  }
  Objects {
    Polygon {
      Name = "CD"
      DomainId = 1
      Priority = ComputationalDomain
      Points = [%(cd_pts)s]
    }
    Polygon {
      Name = "Water"
      DomainId = 2
      Priority = 1
      Points = [%(water_pts)s]
    }
    Polygon {
      Name = "SiN"
      DomainId = 7
      Priority = 1
      Points = [%(sin_pts)s]
    }
    Polygon {
      Name = "OilBlock"
      DomainId = 9
      Priority = 2
      Points = [%(oil_pts)s]
    }
    Polygon {
      Name = "Tip"
      DomainId = 3
      Priority = 4
      Points = [%(tip_pts)s]
      CornerRounding {
        Point = 1
        Radius = %(tip_radius)e
        NPoints = 64
      }
      MeshOptions {
        CurvilinearDegree = %(tip_curv)i
      }
    }
  }
}
