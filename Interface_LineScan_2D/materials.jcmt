#Air
Material {
  DomainId = 1
  RelPermittivity = 1
  RelPermeability = 1
}
<?
# water (domain 2): not present in the uniform-stack stages (keys['stack']), so only written otherwise
keys['water_mat'] = ''
if not keys.get('stack'):
    keys['water_mat'] = ('#Water\nMaterial {\n  DomainId = 2\n  RelPermittivity = (%e, %e)\n  RelPermeability = 1\n}\n'
                         % (keys['water_eps1'], keys['water_eps2']))
?>
%(water_mat)s#Platinum
Material {
  DomainId = 3
  RelPermittivity = (%(pt_eps1)e, %(pt_eps2)e)
  RelPermeability = 1
}
<?
# window: scalar (SN_eps1/2) or, for the equivalent monolayer layers, a diagonal tensor string (SN_tensor)
# plus the window part above the oil block (domain 10, SNoil_tensor)
keys['win_eps'] = keys.get('SN_tensor', '(%e, %e)' % (keys['SN_eps1'], keys['SN_eps2']))
keys['winoil_mat'] = ''
if 'SNoil_tensor' in keys:
    keys['winoil_mat'] = ('#Window above the oil block\nMaterial {\n  DomainId = 10\n  RelPermittivity = '
                          + keys['SNoil_tensor'] + '\n  RelPermeability = 1\n}\n')
# silicon substrate (domain 11, stack stages with a Si substrate only)
keys['si_mat'] = ''
if 'Si_eps1' in keys:
    keys['si_mat'] = ('#Silicon\nMaterial {\n  DomainId = 11\n  RelPermittivity = (%e, %e)\n  RelPermeability = 1\n}\n'
                      % (keys['Si_eps1'], keys['Si_eps2']))
?>
#Window (SiN, or the stage window material)
Material {
  DomainId = 7
  RelPermittivity = %(win_eps)s
  RelPermeability = 1
}
%(winoil_mat)s%(si_mat)s#Oil / OTS
Material {
  DomainId = 9
  RelPermittivity = (%(oil_eps1)e, %(oil_eps2)e)
  RelPermeability = 1
}
