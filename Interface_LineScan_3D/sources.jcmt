# Focused Gaussian beam from the air side, as the instrument's parabolic mirror:
# focus on the SiN top surface at x = y = 0, waist = lambda / (pi NA) (diffraction-limited
# focus of an NA 0.4 mirror), angular spectrum limited to that NA, angle theta from the
# surface normal.  With a waist of a few um the upper tip shaft and its top are barely lit.
# beam_phi and the SP vectors are set by the beam check (run_linescan.py --stage beamcheck)
# so that the beam travels along +x (the backscatter cone points to -x) and
# source 1 is s-polarized (E along y), source 2 p-polarized.
SourceBag {
  Source {
    ElectricFieldStrength {
      GaussianBeam {
        Lambda0 = %(wvl)e
        ThetaPhi = [%(theta)e %(beam_phi)e]
        Incidence = FromAbove
        SP = %(sp_s)e
        Waist = %(waist)e
        Focus = [0 0 0]
        OpticalSystem {
          NumericalAperture = %(beam_na)e
        }
      }
    }
  }
}
SourceBag {
  Source {
    ElectricFieldStrength {
      GaussianBeam {
        Lambda0 = %(wvl)e
        ThetaPhi = [%(theta)e %(beam_phi)e]
        Incidence = FromAbove
        SP = %(sp_p)e
        Waist = %(waist)e
        Focus = [0 0 0]
        OpticalSystem {
          NumericalAperture = %(beam_na)e
        }
      }
    }
  }
}
